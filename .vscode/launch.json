{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Open with Live Server",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/index.html",
            "console": "integratedTerminal"
        },
        {
            "name": "Launch Chrome",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}",
            "file": "${workspaceFolder}/index.html"
        }
    ]
}